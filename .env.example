# Copy to `.env` (git-ignored) and fill in.

# opencode user
USER_NAME=Mike

# User language: en | fr (any other value or missing → en).
# Selects config/AGENTS.<lang>.md for the agents when that file exists.
USER_LANGUAGE=en

# LLM provider for opencode
OPENCODE_PROVIDER=scaleway
OPENCODE_PROVIDER_BASE_URL=https://api.scaleway.ai/v1
OPENCODE_PROVIDER_API_KEY=xxxx

# Tavily web search API key for opencode (leave empty if unused)
TAVILY_API_KEY=xxxx

# Models available to opencode (format: id:context_tokens:output_tokens, space-separated)
OPENCODE_MODELS=deepseek-v4.1-flash:262144:32768 glm-5.3:262144:16384

# Default opencode model (bare name, no provider prefix)
OPENCODE_DEFAULT_MODEL=deepseek-v4.1-flash

# Restrict opencode's /models list to the declared models only (1 = yes, 0 = no)
OPENCODE_MODELS_WHITELIST=1

# Default Anthropic model for Claude Code
CLAUDE_DEFAULT_MODEL=claude-opus-5-5

# Git identity inside the container
GIT_NAME=Mike
GIT_EMAIL=mike@gmail.com

# Global domains allowed by the egress proxy (space-separated)
DOMAIN_GLOBAL_WHITELIST=google.com traefik.com docker.com github.com raw.githubusercontent.com debian.org npmjs.com npmjs.org packagist.org nodejs.org nginx.org getcomposer.org ovhcloud.com ovh.com scaleway.com scaleway.ai opencode.ai anthropic.com claude.ai claude.com openai.com tavily.com tinyfish.io models.dev

# Stack-wide domain whitelist
DOMAIN_WHITELIST=1

# Pinned files protection
PIN_PROTECTION=1

# Host-side Docker bridge IP (docker0 on Linux, adjust on macOS/Windows)
HOST_DOCKER_INTERNAL=172.17.0.1

# Default agent when starting the stack: claude | opencode (overridden by AGENT= at launch)
DEFAULT_AGENT=opencode

# Default project when starting the stack (overridden by PROJECT= at launch)
DEFAULT_PROJECT=xxxx