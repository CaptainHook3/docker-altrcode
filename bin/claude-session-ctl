#!/usr/bin/env python3
"""claude-session-ctl — manage the Claude Code sessions of the docker-altrcode sandbox.

Usage:
    claude-session-ctl list                # list sessions (most recent first)
    claude-session-ctl clean               # delete ALL sessions (asks for confirmation)
    claude-session-ctl clean --yes         # same, without confirmation
    claude-session-ctl clean <session-id>  # delete a single session

A Claude Code (2.x) session is spread across several locations:
  projects/<project>/<id>.jsonl  transcript (what /resume reads)
  projects/<project>/<id>/       artifacts (tool-results, subagents)
  file-history/<id>/             file snapshots (/rewind)
  session-env/<id>/              session environment
  history.jsonl                  prompt history (↑ / Ctrl+R), sessionId field
projects/<project>/memory/ (auto memory) is never touched.

CLAUDE_SESSION_CONF: path of the sandbox claude directory
(read from the environment, default: XDG_CONFIG_HOME/docker-altrcode/claude).
"""
import datetime
import glob
import json
import os
import re
import shutil
import sys
import time


def _claude_dir() -> str:
    return os.environ.get("CLAUDE_SESSION_CONF") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
        "docker-altrcode", "claude",
    )


CLAUDE_DIR = _claude_dir()
HISTORY_FILE = os.path.join(CLAUDE_DIR, "history.jsonl")
PROJECTS_DIR = os.path.join(CLAUDE_DIR, "projects")
# Directories keyed by session id, at the root of the claude directory.
SESSION_DIRS = [os.path.join(CLAUDE_DIR, d) for d in ("file-history", "session-env")]

# A session id is a UUID: prevents deleting anything outside the target (memory, ../…).
SID_RE = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")
# Max number of transcript lines read to find the first prompt.
TITLE_SCAN_LINES = 200
BRANCH_RE = re.compile(r'"gitBranch":"([^"]*)"')


def read_history() -> list[dict]:
    if not os.path.isfile(HISTORY_FILE):
        return []
    entries = []
    with open(HISTORY_FILE, encoding="utf-8", errors="replace") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                entries.append(json.loads(line))
            except json.JSONDecodeError:
                pass
    return entries


def _user_text(obj: dict) -> str:
    """Text of a transcript user message ("" if the entry is not one)."""
    if obj.get("type") != "user" or obj.get("isMeta"):
        return ""
    msg = obj.get("message")
    content = msg.get("content") if isinstance(msg, dict) else None
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        for block in content:
            if isinstance(block, dict) and block.get("type") == "text":
                return block.get("text", "")
    return ""


def transcript_meta(path: str) -> dict:
    """Title and branch of a transcript, as /resume shows them (single read).

    Title: custom-title (/rename) > ai-title (generated by Claude) > first prompt.
    For the first two, the last occurrence wins. Branch: last gitBranch.
    """
    meta = {"custom_title": "", "ai_title": "", "first_user": "", "branch": ""}
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for i, line in enumerate(f):
                # Only parse relevant lines as JSON: a transcript can weigh tens of MB.
                if '"custom-title"' in line or '"ai-title"' in line:
                    try:
                        obj = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if obj.get("type") == "custom-title" and obj.get("customTitle"):
                        meta["custom_title"] = obj["customTitle"]
                    elif obj.get("type") == "ai-title" and obj.get("aiTitle"):
                        meta["ai_title"] = obj["aiTitle"]
                if '"gitBranch"' in line:
                    m = BRANCH_RE.search(line)
                    if m:
                        meta["branch"] = m.group(1)
                if not meta["first_user"] and i < TITLE_SCAN_LINES and '"user"' in line:
                    try:
                        meta["first_user"] = _user_text(json.loads(line)).strip()
                    except (json.JSONDecodeError, AttributeError):
                        pass
    except OSError:
        pass
    return meta


def _transcripts() -> dict[str, str]:
    """Session id → transcript path (projects/<project>/<id>.jsonl)."""
    found = {}
    for path in glob.glob(os.path.join(PROJECTS_DIR, "*", "*.jsonl")):
        sid = os.path.basename(path)[: -len(".jsonl")]
        if SID_RE.match(sid):
            found[sid] = path
    return found


def find_sessions(entries: list[dict]) -> list[dict]:
    """Merges transcripts and history.jsonl, returns one session per UUID."""
    sessions: dict[str, dict] = {}

    def get(sid: str) -> dict:
        return sessions.setdefault(sid, {
            "session_id": sid,
            "first_prompt": "",
            "last_ts": 0.0,
            "count": 0,
            "transcript": None,
        })

    for e in entries:
        sid = e.get("sessionId", "")
        if not sid:
            continue
        s = get(sid)
        ts = e.get("timestamp", 0) / 1000  # ms → s
        if not s["first_prompt"]:
            s["first_prompt"] = e.get("display", "")
        s["count"] += 1
        s["last_ts"] = max(s["last_ts"], ts)

    for sid, path in _transcripts().items():
        s = get(sid)
        s["transcript"] = path
        try:
            s["last_ts"] = max(s["last_ts"], os.path.getmtime(path))
        except OSError:
            pass

    return sorted(sessions.values(), key=lambda s: s["last_ts"], reverse=True)


def fmt_ts(ts: float) -> str:
    if not ts:
        return "-"
    try:
        return datetime.datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M")
    except (ValueError, OSError):
        return "-"


def fmt_size(path: str) -> str:
    try:
        n = float(os.path.getsize(path))
    except OSError:
        return "-"
    for unit in ("B", "KB", "MB"):
        if n < 1024 or unit == "MB":
            return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024
    return "-"


def cmd_list() -> int:
    sessions = find_sessions(read_history())
    # No transcript = nothing to resume (typically a /resume opened then cancelled):
    # hidden as in /resume, but still deleted by clean.
    hidden = sum(1 for s in sessions if not s["transcript"])
    sessions = [s for s in sessions if s["transcript"]]
    if not sessions:
        print(f"no Claude Code session (directory: {CLAUDE_DIR})")
        return 0
    print(f"{'ID (UUID)':<36}  {'NB':>3}  {'Last':<16}  {'Size':>7}  {'Branch':<30}  Title")
    print("-" * 140)
    for s in sessions:
        meta = transcript_meta(s["transcript"])
        branch = meta["branch"] or "-"
        title = meta["custom_title"] or meta["ai_title"] or meta["first_user"] or s["first_prompt"]
        if len(branch) > 30:
            branch = branch[:29] + "…"
        title = " ".join(title.split())[:60]
        print(
            f"{s['session_id']:<36}  {s['count']:>3}  {fmt_ts(s['last_ts']):<16}  "
            f"{fmt_size(s['transcript']):>7}  {branch:<30}  {title}"
        )
    print("-" * 140)
    print(f"total: {len(sessions)} session(s)  —  NB = prompts in history.jsonl  —  titles match /resume")
    if hidden:
        print(f"{hidden} history entr(y/ies) without a conversation hidden (deleted by clean)")
    return 0


def ask_confirm(prompt: str) -> bool:
    try:
        ans = input(prompt + " [y/N] ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        return False
    return ans in ("y", "yes", "o", "oui")


def _remove_session_files(sid: str) -> None:
    """Deletes the transcript, artifacts and directories keyed by the session id."""
    if not SID_RE.match(sid):
        return
    for path in glob.glob(os.path.join(PROJECTS_DIR, "*", sid + ".jsonl")):
        try:
            os.remove(path)
        except OSError:
            pass
    dirs = glob.glob(os.path.join(PROJECTS_DIR, "*", sid))
    dirs += [os.path.join(d, sid) for d in SESSION_DIRS]
    for d in dirs:
        if os.path.isdir(d):
            shutil.rmtree(d, ignore_errors=True)


def _backup_history() -> str | None:
    if not os.path.isfile(HISTORY_FILE):
        return None
    ts = time.strftime("%Y%m%d-%H%M%S")
    bkp = HISTORY_FILE + f".backup-{ts}"
    shutil.copy2(HISTORY_FILE, bkp)
    return bkp


def _write_history(entries: list[dict]) -> None:
    if not os.path.isfile(HISTORY_FILE):
        return
    with open(HISTORY_FILE, "w", encoding="utf-8") as f:
        for e in entries:
            f.write(json.dumps(e, ensure_ascii=False) + "\n")


def _orphan_dirs() -> list[str]:
    """file-history/session-env directories of sessions with neither transcript nor history."""
    known = {s["session_id"] for s in find_sessions(read_history())}
    found = []
    for d in SESSION_DIRS:
        for sub in os.listdir(d) if os.path.isdir(d) else []:
            if SID_RE.match(sub) and sub not in known:
                found.append(os.path.join(d, sub))
    return found


def cmd_clean(sid: str | None, force: bool) -> int:
    entries = read_history()
    sessions = find_sessions(entries)

    if not sessions:
        orphans = [] if sid else _orphan_dirs()
        for d in orphans:
            shutil.rmtree(d, ignore_errors=True)
        print("no session to clean."
              + (f" ({len(orphans)} orphan director(y/ies) deleted)" if orphans else ""))
        return 0

    if sid:
        if not SID_RE.match(sid):
            print(f"invalid session id (UUID expected): {sid}", file=sys.stderr)
            return 1
        if not any(s["session_id"] == sid for s in sessions):
            print(f"session not found: {sid}", file=sys.stderr)
            return 1
        bkp = _backup_history()
        kept = [e for e in entries if e.get("sessionId") != sid]
        _write_history(kept)
        _remove_session_files(sid)
        removed = len(entries) - len(kept)
        print(f"session deleted: {sid} ({removed} prompt(s), transcript and artifacts)")
    else:
        n = len(sessions)
        m = len(entries)
        if not force:
            if not ask_confirm(f"Delete ALL {n} Claude Code session(s) ({m} prompt(s))?"):
                print("cancelled — nothing was deleted.")
                return 0
        bkp = _backup_history()
        _write_history([])
        for s in sessions:
            _remove_session_files(s["session_id"])
        for d in _orphan_dirs():
            shutil.rmtree(d, ignore_errors=True)
        print(f"{n} session(s) deleted ({m} prompt(s), transcripts and artifacts)")
    if bkp:
        print(f"history.jsonl backup: {bkp}")
    return 0


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        return 2
    cmd = args[0]
    if cmd == "list":
        return cmd_list()
    if cmd == "clean":
        rest = [a for a in args[1:] if a.strip() and a not in ("-y", "--yes")]
        force = len(rest) != len([a for a in args[1:] if a.strip()])
        sid = rest[0] if rest else None
        return cmd_clean(sid, force)
    print("usage: claude-session-ctl {list | clean [--yes] [session-id]}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
