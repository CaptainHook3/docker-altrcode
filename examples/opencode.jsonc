// Example chrome-devtools MCP for opencode, to place at the root of the target project
{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--browserUrl", "http://172.17.0.1:9222"],
      "enabled": true,
      "environment": {
        "NO_PROXY": "localhost,127.0.0.1,::1,172.17.0.1",
        "no_proxy": "localhost,127.0.0.1,::1,172.17.0.1"
      }
    }
  }
}
